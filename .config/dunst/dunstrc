[global]
width = (200, 500)
offset = 0x65
origin = top-center

corner_radius = 8
frame_width = 3

alignment = center

icon_corner_radius = 2

idle_threshold = 10m

font = Monospace 12

[urgency_normal]
timeout = 3s

# colours remain unchanged; generated by i3 theme.sh
background = "#0C182F"
foreground = "#c6bec1"
frame_color = "#5C6791"

[urgency_low]
timeout = 1s

# colours remain unchanged; generated by i3 theme.sh
background = "#0C182F"
foreground = "#c6bec1"
frame_color = "#5C6791"
